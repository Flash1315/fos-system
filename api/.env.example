# Fos API
APP_NAME=Fos
# development | production — production refuses weak SECRET_KEY (<32 chars / known defaults)
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./fos.db
# DATABASE_URL=postgresql+psycopg2://fos:fos@localhost:5432/fos
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated origins (avoid * in production)
CORS_ORIGINS=*
# Behind a trusted reverse proxy only:
# TRUST_X_FORWARDED_FOR=true
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
# In production, TRUST_X_FORWARDED_FOR=true requires at least one valid CIDR/IP above.
# Soft ceiling for org-wide member loops / invites (balances / directory / org report)
# MAX_ORG_MEMBERS=300
# Rate limits are process-local (≈N× under N workers) — not shared Redis
# RATE_LIMIT_ENABLED=true
# Production refuses RATE_LIMIT_ENABLED=false
# MEDIA_BACKEND=local
# MEDIA_BACKEND=s3 requires S3_BUCKET (required in production)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=  # MinIO / Cloudflare R2 compatible
# S3_PUBLIC_BASE_URL=  # reserved; media always streams via authenticated API
# ENABLE_HSTS=true
# HSTS_MAX_AGE=31536000  # 0..63072000; validated at startup
# IDEMPOTENCY_TTL_HOURS=72  # 1..168; validated at startup
# Optional SMTP — invite / password-reset emails when SMTP_HOST is set
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
# PUBLIC_APP_URL=https://app.example.com
# Optional Telegram bot for org notifications
# TELEGRAM_BOT_TOKEN=
# Allow POST /billing/plan stub switches (off by default)
# BILLING_PLAN_SWITCH=false
# Postgres pool / SSL (ignored for SQLite)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30
# DB_CONNECT_TIMEOUT=10
# DB_SSLMODE=require
# Prefer DATABASE_URL=...postgresql+psycopg2://...?sslmode=require in production
# Shared rate limits across workers (optional)
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
