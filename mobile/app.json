{
  "expo": {
    "name": "Fos",
    "slug": "fos",
    "version": "0.7.100",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.fos.system"
    },
    "android": {
      "package": "app.fos.system",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fos to attach receipt photos.",
          "cameraPermission": "Allow Fos to photograph receipts."
        }
      ]
    ]
  }
}
